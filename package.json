{
  "name": "use-effect-event",
  "version": "2.0.4",
  "description": "Ponyfill of the `React.useEffectEvent` hook, which became stable in React 19.2",
  "keywords": [
    "effect",
    "hooks",
    "react",
    "react18",
    "react19",
    "sanity",
    "sanity-io",
    "typescript",
    "use",
    "useEffectEvent",
    "useEvent"
  ],
  "bugs": {
    "url": "https://github.com/sanity-io/use-effect-event/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "contributors": [
    "Cody Olsen <stipsan@gmail.com> (https://github.com/stipsan)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/use-effect-event.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepublishOnly": "pnpm build",
    "release": "changeset publish",
    "test": "vitest run",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@sanity/tsconfig": "^2.2.1",
    "@sanity/tsdown-config": "^0.26.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "oxc-transform-react": "^0.147.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^18.3 || ^19.0.0-0"
  },
  "packageManager": "pnpm@11.24.0"
}
