{
  "name": "use-effect-event",
  "version": "2.0.3",
  "description": "Ponyfill of the experimental `React.useEffectEvent` hook",
  "keywords": [
    "effect",
    "hooks",
    "react",
    "react18",
    "react19",
    "sanity",
    "sanity-io",
    "typescript",
    "use",
    "useEffectEvent",
    "useEvent"
  ],
  "bugs": {
    "url": "https://github.com/sanity-io/use-effect-event/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "contributors": [
    "Cody Olsen <stipsan@gmail.com> (https://github.com/stipsan)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/use-effect-event.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pkg build --strict --clean --check",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepare": "pnpm build",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "watch": "pnpm build -- --watch"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "^8.1.4",
    "@sanity/semantic-release-preset": "^5.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "semantic-release": "^24.2.7",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^18.3 || ^19.0.0-0"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "peerDependencyRules": {
      "allowAny": [
        "react",
        "react-dom"
      ]
    }
  }
}
